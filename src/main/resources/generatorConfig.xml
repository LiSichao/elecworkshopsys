<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>

    <context id="context" targetRuntime="MyBatis3Simple">

        <commentGenerator>
            <property name="suppressAllComments" value="true"/>
            <property name="suppressDate" value="true"/>
        </commentGenerator>

        <!-- 配置数据库连接 -->
        <jdbcConnection driverClass="com.mysql.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/elecworkshopsys?useUnicode=true&amp;characterEncoding=utf-8&amp;useSSL=false"
                        userId="root" password="root">
        </jdbcConnection>

        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
            <property name="useJSR310Types" value="true"/>
        </javaTypeResolver>

        <!-- 指定javaBean生成的位置 -->
        <javaModelGenerator targetPackage="com.design.elecworkshopsys.bean" targetProject=".\src\main\java">
            <property name="enableSubPackages" value="true"/>
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <!-- table指定每个表的生成策略 -->
        <!--<table tableName="t_user" domainObjectName="User">
            <columnRenamingRule searchString="^user" replaceString="" />
        </table>-->
        <!--<table tableName="t_fault" domainObjectName="Fault">
            <columnRenamingRule searchString="^fault" replaceString=""/>
        </table>-->
        <!--<table tableName="t_process" domainObjectName="Process">
            <columnRenamingRule searchString="^process" replaceString=""/>
        </table>-->
        <!--<table tableName="t_station" domainObjectName="Station">
            <columnRenamingRule searchString="^station" replaceString=""/>
        </table>-->
        <!--<table tableName="t_spare" domainObjectName="Spare">
            <columnRenamingRule searchString="^spare" replaceString=""/>
        </table>-->
       <!-- <table tableName="t_dept" domainObjectName="Dept">
            <columnRenamingRule searchString="^dept" replaceString="" />
        </table>-->
        <table tableName="t_memo" domainObjectName="Memo">
            <columnRenamingRule searchString="^memo" replaceString=""/>
        </table>

    </context>
</generatorConfiguration>